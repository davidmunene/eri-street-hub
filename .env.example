# Copy to .env and fill in. NEVER commit .env.

# Postgres connection (local default matches docker-compose.yml)
DATABASE_URL="postgresql://eri:eri_local_dev@localhost:5433/eri_street_hub?schema=public"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# First administrator created by `npm run db:seed`.
# They will be asked to change this password on first sign-in.
SEED_ADMIN_EMAIL="admin@example.org"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="System Administrator"

# Set to "true" to also create fictional demo members, beneficiaries, events, etc.
SEED_DEMO="false"
# Password for demo accounts (defaults to SEED_ADMIN_PASSWORD)
SEED_DEMO_PASSWORD=""

# Optional: Vercel Blob token for file uploads in production.
# When empty, files are stored in ./uploads and served only to signed-in users.
BLOB_READ_WRITE_TOKEN=""
